    "expo-localization": "*",
    "expo-router": "~58.0.32",
    "expo-status-bar": "*",
    "i18next": "^25.0.0",
    "leaflet": "^1.9.4",
    "nativewind": "^4.1.23",
    "react": "*",
    "react-dom": "*",
    "react-i18next": "^15.0.0",
    "react-native": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
